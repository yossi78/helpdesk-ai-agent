    {
      "name": "Ollama",
      "description": "HTTP calls this project makes to the local Ollama server. Docker waits with `GET /api/tags` (`ollama list`) then `POST /api/pull` (`ollama pull llama3.2`). The harness `OllamaProvider` then chats with `POST /api/chat` (native tool-calling, not OpenAI `/v1`). Start with `docker compose up ollama`.",
      "item": [
        {
          "name": "List models",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ollama_url}}/api/tags",
            "description": "List locally available models. Docker `entrypoint.sh` polls this (via `ollama list`) until the API is up."
          },
          "response": [
            {
              "name": "llama3.2 present",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": "{{ollama_url}}/api/tags"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"models\": [\n    {\n      \"name\": \"llama3.2:latest\",\n      \"model\": \"llama3.2:latest\",\n      \"size\": 2019393189,\n      \"digest\": \"a80c4f17acd5\",\n      \"details\": {\n        \"family\": \"llama\",\n        \"parameter_size\": \"3.2B\",\n        \"quantization_level\": \"Q4_K_M\"\n      }\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Pull model",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{ollama_model}}\",\n  \"stream\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{ollama_url}}/api/pull",
            "description": "Download `llama3.2` if missing. Docker `entrypoint.sh` does this via `ollama pull ${OLLAMA_MODEL}`. `stream: false` returns one JSON object (first boot is ~2GB)."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"llama3.2\",\n  \"stream\": false\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{ollama_url}}/api/pull"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\"\n}"
            }
          ]
        },
        {
          "name": "Chat (ticket_stats first turn)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{ollama_model}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a help-desk agent.\\nUse only the ticket_stats tool to gather numbers; do not invent counts.\\nFirst call ticket_stats with no arguments for the whole queue.\\nThen call ticket_stats with user_id \\\"u-42\\\" for Alice Wong.\\nAfter both results, summarize and stop.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Give me a snapshot of the support ticket queue,\\nthen Alice Wong's (u-42) ticket load.\"\n    }\n  ],\n  \"stream\": false,\n  \"options\": {\n    \"temperature\": 0.0\n  },\n  \"tools\": [\n    {\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"ticket_stats\",\n        \"description\": \"Summarize the support ticket queue: total count plus breakdowns by status and priority. Optionally filter by user_id.\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"user_id\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{ollama_url}}/api/chat",
            "description": "First `OllamaProvider.complete()` call for `scenarios/ticket_stats.yaml`. Native `POST /api/chat` with `stream: false`, temperature 0, and the `ticket_stats` tool schema."
          },
          "response": [
            {
              "name": "Tool calls",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{ollama_url}}/api/chat"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"model\": \"llama3.2\",\n  \"message\": {\n    \"role\": \"assistant\",\n    \"content\": \"\",\n    \"tool_calls\": [\n      {\n        \"function\": {\n          \"name\": \"ticket_stats\",\n          \"arguments\": {}\n        }\n      },\n      {\n        \"function\": {\n          \"name\": \"ticket_stats\",\n          \"arguments\": {\n            \"user_id\": \"u-42\"\n          }\n        }\n      }\n    ]\n  },\n  \"done\": true\n}"
            }
          ]
        },
        {
          "name": "Chat (after tool results)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{ollama_model}}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a help-desk agent.\\nUse only the ticket_stats tool to gather numbers; do not invent counts.\\nFirst call ticket_stats with no arguments for the whole queue.\\nThen call ticket_stats with user_id \\\"u-42\\\" for Alice Wong.\\nAfter both results, summarize and stop.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Give me a snapshot of the support ticket queue,\\nthen Alice Wong's (u-42) ticket load.\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"\",\n      \"tool_calls\": [\n        {\n          \"function\": {\n            \"name\": \"ticket_stats\",\n            \"arguments\": {}\n          }\n        },\n        {\n          \"function\": {\n            \"name\": \"ticket_stats\",\n            \"arguments\": {\n              \"user_id\": \"u-42\"\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"role\": \"tool\",\n      \"tool_name\": \"ticket_stats\",\n      \"content\": \"{\\n  \\\"total\\\": 5,\\n  \\\"by_status\\\": {\\n    \\\"open\\\": 4,\\n    \\\"closed\\\": 1\\n  },\\n  \\\"by_priority\\\": {\\n    \\\"normal\\\": 1,\\n    \\\"high\\\": 2,\\n    \\\"low\\\": 2\\n  }\\n}\"\n    },\n    {\n      \"role\": \"tool\",\n      \"tool_name\": \"ticket_stats\",\n      \"content\": \"{\\n  \\\"total\\\": 2,\\n  \\\"by_status\\\": {\\n    \\\"open\\\": 2\\n  },\\n  \\\"by_priority\\\": {\\n    \\\"normal\\\": 1,\\n    \\\"high\\\": 1\\n  }\\n}\"\n    }\n  ],\n  \"stream\": false,\n  \"options\": {\n    \"temperature\": 0.0\n  },\n  \"tools\": [\n    {\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"ticket_stats\",\n        \"description\": \"Summarize the support ticket queue: total count plus breakdowns by status and priority. Optionally filter by user_id.\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"user_id\": {\n              \"type\": \"string\"\n            }\n          }\n        }\n      }\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{ollama_url}}/api/chat",
            "description": "Follow-up `OllamaProvider.complete()` after the agent executed tools. Ollama requires every `content` field to be a string (tool results are JSON text, not objects). OpenAI-style history is translated to native messages (`tool_name` on tool rows, function arguments as objects)."
          },
          "response": [
            {
              "name": "Summary",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{ollama_url}}/api/chat"
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"model\": \"llama3.2\",\n  \"message\": {\n    \"role\": \"assistant\",\n    \"content\": \"The queue has 5 tickets (4 open, 1 closed).\\nAlice Wong (u-42) has 2 open tickets.\"\n  },\n  \"done\": true\n}"
            }
          ]
        }
      ]
    }
  ]
